{
  "expo": {
    "name": "Suivi Enfant",
    "slug": "mon-enfant",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",

    "splash": {
      "backgroundColor": "#ffffff"
    },

    "assetBundlePatterns": [
      "**/*"
    ],

    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cette application utilise votre position pour permettre à vos parents de suivre votre trajet.",
          "locationAlwaysAndWhenInUsePermission": "Cette application utilise votre position pour permettre à vos parents de suivre votre trajet, même en arrière-plan.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.votrenom.suivienfant"
    },

    "android": {
      "package": "com.votrenom.suivienfant",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    }
  }
}
