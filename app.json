{
  "expo": {
    "name": "Suivi Enfant",
    "slug": "mon-enfant",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",

    "splash": {
      "backgroundColor": "#ffffff"
    },

    "assetBundlePatterns": [
      "*/"
    ],

    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cette application utilise votre position pour permettre à vos parents de suivre votre trajet.",
          "locationAlwaysAndWhenInUsePermission": "Cette application utilise votre position pour permettre à vos parents de suivre votre trajet, même en arrière-plan.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.votrenom.suivienfant",
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "fetch"
        ],
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Cette application utilise votre position pour permettre à vos parents de vous suivre pendant le trajet école-maison."
      }
    },

    "android": {
      "package": "com.votrenom.suivienfant",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ],
      "foregroundService": {
        "notificationTitle": "Suivi de trajet actif",
        "notificationBody": "Votre position est partagée avec vos parents.",
        "notificationColor": "#4F46E5"
      }
    },

    "extra": {
      "eas": {
        "projectId": "779cf452-9c71-4a0e-b8be-08ed8ad8d800"
      }
    }
  }
}